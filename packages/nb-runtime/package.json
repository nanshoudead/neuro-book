{
    "name": "@notnotype/nb-runtime",
    "version": "0.3.0",
    "description": "NeuroBook 内核：运行作用域与资源生命周期、服务装配、插件、应用门禁、诊断与远程服务；唯一运行时依赖是 TypeBox，各运行位置的宿主共用。",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/notnotype/neuro-book.git",
        "directory": "packages/nb-runtime"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "engines": {
        "bun": ">=1.3.14"
    },
    "exports": {
        "./lifecycle": "./src/lifecycle/lifecycle.ts",
        "./lifecycle/testing": "./src/lifecycle/testing/manual-clock.ts",
        "./services": "./src/services/services.ts",
        "./plugins": "./src/plugins/plugins.ts",
        "./plugin-manifest": "./src/plugin-manifest/plugin-manifest.ts",
        "./application": "./src/application/application.ts",
        "./diagnostics": "./src/diagnostics/diagnostics.ts",
        "./remote": "./src/remote/remote.ts",
        "./remote/testing": "./src/remote/testing/in-process.ts"
    },
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json"
    },
    "dependencies": {
        "typebox": "^1.3.6"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/semver": "^7.7.1",
        "semver": "^7.8.5",
        "typescript": "^6.0.3"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "README.md",
        "LICENSE"
    ]
}
