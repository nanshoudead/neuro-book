{
    "name": "@notnotype/nb-story",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "bun": ">=1.3.14"
    },
    "bin": {
        "nbstory": "./src/cli.ts"
    },
    "exports": {
        ".": "./src/core/index.ts",
        "./contract": "./src/contract/contract.ts"
    },
    "scripts": {
        "test": "bun test",
        "nbstory": "bun src/cli.ts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.web-test.json && tsc --noEmit -p e2e/tsconfig.json",
        "build:web": "vite build",
        "test:e2e": "bun run build:web && playwright test -c e2e/playwright.config.ts"
    },
    "dependencies": {
        "@clack/prompts": "^1.0.0",
        "@notnotype/nb-agent-ui": "workspace:*",
        "@notnotype/nb-form": "workspace:*",
        "@notnotype/nb-harness": "workspace:*",
        "@notnotype/nb-markdown": "workspace:*",
        "@notnotype/nb-profile": "workspace:*",
        "@notnotype/nb-runtime": "workspace:*",
        "@notnotype/nb-session": "workspace:*",
        "@notnotype/nb-ui": "workspace:*",
        "@sigma/node-border": "3.0.0",
        "@sigma/utils": "3.0.0",
        "commander": "^14.0.2",
        "eventsource-parser": "^3.0.6",
        "graphology": "0.26.0",
        "graphology-layout-forceatlas2": "0.10.1",
        "graphology-layout-noverlap": "0.4.2",
        "openai": "^6.26.0",
        "sigma": "3.0.3",
        "typebox": "^1.3.6",
        "vue": "^3.5.24",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.95",
        "@iconify/tailwind4": "^1.2.3",
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "graphology-types": "^0.24.8",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.1.4",
        "vue-tsc": "^3.3.7"
    }
}
