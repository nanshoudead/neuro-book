{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "nbook/*": ["./src/*"],
            "@notnotype/nb-plugin-sdk": ["./src/sdk/index.ts"],
            "@notnotype/nb-plugin-sdk/browser": ["./src/sdk/browser.ts"],
            "@notnotype/nb-plugin-sdk/components": ["./src/sdk/components.ts"]
        }
    },
    "include": ["src/web", "src/ui", "src/plugins/*/web", "src/plugins/*/plugin.ts", "src/plugins/*/shared", "src/shared", "src/plugin-platform/web", "src/plugin-platform/shared", "src/plugin-platform-profile.ts", "src/sdk", "src/manifest.ts", "src/development-manifest.ts", "examples/plugins/*/web", "examples/plugins/*/plugin.ts", "examples/plugins/*/shared"],
    "exclude": ["**/*.test.ts", "src/plugins/*/web/testing"]
}
