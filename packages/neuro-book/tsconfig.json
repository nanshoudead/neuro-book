{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "types": ["bun"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "nbook/*": ["./src/*"],
            "@notnotype/nb-plugin-sdk": ["./src/sdk/index.ts"],
            "@notnotype/nb-plugin-sdk/browser": ["./src/sdk/browser.ts"],
            "@notnotype/nb-plugin-sdk/components": ["./src/sdk/components.ts"]
        }
    },
    "include": [
        "src/*.ts",
        "src/server",
        "src/project",
        "src/shared",
        "src/sdk/index.ts",
        "src/types",
        "src/plugins/*/plugin.ts",
        "src/plugins/*/backend",
        "src/plugins/*/shared",
        "src/**/*.test.ts",
        "examples/testing",
        "examples/scenarios",
        "examples/plugins/*/plugin.ts",
        "examples/plugins/*/backend",
        "examples/plugins/*/shared",
        "scripts",
        "vite.config.ts",
        "vite.e2e.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["src/**/*.dom.test.ts", "src/plugins/*/web/**/*.test.ts", "scripts/lab-shot.ts", "scripts/page-shot.ts", "scripts/page-shot.test.ts", "scripts/perf/files-perf.ts", "scripts/perf/page-agent.ts", "scripts/perf/browser-runner.ts"]
}
