{
    "name": "@notnotype/dev-panel",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "bun": ">=1.3.14"
    },
    "bin": {
        "nbdev": "./src/cli.ts"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "test": "bun test --isolate",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.web-tests.json",
        "build:web": "vite build",
        "install-shim": "bun src/install-shim.ts",
        "audit-init": "bun src/audit-init.ts",
        "install-service": "bun src/install-service.ts",
        "service": "bun src/service.ts",
        "service:status": "bun src/service.ts status",
        "service:start": "bun src/service.ts start",
        "service:stop": "bun src/service.ts stop",
        "service:restart": "bun src/service.ts restart",
        "service:logs": "bun src/service.ts logs"
    },
    "dependencies": {
        "@notnotype/nb-ui": "workspace:*",
        "@xterm/xterm": "6.0.0",
        "dompurify": "^3.3.3",
        "marked": "^17.0.3",
        "parse5": "^8.0.1",
        "vue": "^3.5.24",
        "vue-router": "^5.1.0",
        "yaml": "^2.8.2"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.95",
        "@iconify/tailwind4": "^1.2.3",
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.1.4",
        "vue-tsc": "^3.3.7"
    }
}
