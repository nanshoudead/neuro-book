{
    "name": "@notnotype/nb-agent-ui",
    "version": "0.1.0",
    "description": "Agent 对话视图：核心（视图类型、分轮与摘要、发送规则、harness 适配器）是纯 TS；Vue 渲染层建在 nb-ui 之上，Markdown 与提示词编辑器由宿主注入。",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/notnotype/neuro-book.git",
        "directory": "packages/nb-agent-ui"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./vue": "./src/vue/index.ts",
        "./lab": "./src/vue/lab.ts",
        "./lab-sources": "./src/vue/lab-sources.ts",
        "./tailwind.css": "./src/tailwind.css"
    },
    "scripts": {
        "test": "bun test && vitest run",
        "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json"
    },
    "dependencies": {
        "@notnotype/nb-ui": "workspace:^"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.95",
        "@notnotype/nb-harness": "workspace:^",
        "@notnotype/nb-profile": "workspace:^",
        "@notnotype/nb-session": "workspace:^",
        "@notnotype/neuro-book-test-support": "workspace:*",
        "@types/bun": "^1.3.14",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "happy-dom": "^20.10.6",
        "typebox": "^1.3.6",
        "typescript": "^6.0.3",
        "vitest": "^4.1.2",
        "vue": "^3.5.24",
        "vue-tsc": "^3.3.7"
    },
    "peerDependencies": {
        "typescript": "^5.4.0 || ^6.0.0",
        "vue": "^3.5.24"
    },
    "engines": {
        "bun": ">=1.3.14"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "README.md",
        "LICENSE"
    ]
}
