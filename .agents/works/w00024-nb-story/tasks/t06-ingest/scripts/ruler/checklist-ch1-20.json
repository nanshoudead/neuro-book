 "items": [
  { "id": "L1", "category": "账本数值", "readAt": { "chapter": 5 }, "from": ["M01a"], "text": "读到第 5 章末，苏天晴的神典石为 250（启动资金 200，买强化药 A 花 50，任务奖励 100）", "check": { "kind": "ledger-value", "owner": "苏天晴", "track": ["神典石"], "expect": 250 } },
