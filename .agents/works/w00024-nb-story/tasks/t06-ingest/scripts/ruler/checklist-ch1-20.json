  { "id": "L3", "category": "账本数值", "readAt": { "chapter": 11 }, "from": ["M01b"], "text": "读到第 11 章末，苏天晴的神典石为 500", "check": { "kind": "ledger-value", "owner": "苏天晴", "track": ["神典石"], "expect": 500 } },
  { "id": "L4", "category": "账本数值", "readAt": { "chapter": 17 }, "from": ["M01c"], "text": "读到第 17 章末，苏天晴的神典石为 800", "check": { "kind": "ledger-value", "owner": "苏天晴", "track": ["神典石"], "expect": 800 } },
  { "id": "L5", "category": "账本数值", "readAt": { "chapter": 9 }, "from": ["M02"], "text": "读到第 9 章末，匿名账号的粉丝数为 500", "check": { "kind": "ledger-value", "track": ["粉丝", "关注"], "expect": 500 } },
  { "id": "L6", "category": "账本数值", "readAt": { "chapter": 12 }, "from": ["M02"], "text": "读到第 12 章末，匿名账号的粉丝数为 1000", "check": { "kind": "ledger-value", "track": ["粉丝", "关注"], "expect": 1000 } },
  { "id": "L7", "category": "账本数值", "readAt": { "chapter": 15 }, "from": ["M02"], "text": "读到第 15 章末，粉丝数没有被记成 3000 或更多（“这两天就能突破三千”只是估计）", "check": { "kind": "ledger-value", "track": ["粉丝", "关注"], "expect": 3000, "op": "lt" } },
  { "id": "L8", "category": "道具", "readAt": { "chapter": 11 }, "from": ["M01b"], "text": "读到第 11 章末，苏天晴持有魔力探查器、摄像头、定身陷阱，不再持有强化药 A", "check": { "kind": "ledger-holdings", "owner": "苏天晴", "held": [["探查器"], ["摄像头"], ["定身陷阱", "陷阱"]], "notHeld": [["强化药"]] } },
  { "id": "L9", "category": "道具", "readAt": { "chapter": 17 }, "from": ["M01c", "J02"], "text": "读到第 17 章末，苏天晴没有买过怪人强化药 S（账本里没有这一笔，也没有持有）", "check": { "kind": "ledger-spends", "owner": "苏天晴", "track": ["神典石", "道具"], "spends": [], "forbidKeywords": ["强化药S", "强化药 S", "强化药Ｓ"] } },
  { "id": "L10", "category": "道具", "readAt": { "chapter": 11 }, "from": ["F03"], "text": "读到第 11 章末，神典石的支出有：强化药 A 50、摄像头 50、定身陷阱 100、魔力探查器 500、河蟹捕捞装置 100；没有 400 的一笔", "check": { "kind": "ledger-spends", "owner": "苏天晴", "track": ["神典石"], "spends": [{ "amount": 50, "keywords": ["强化药"] }, { "amount": 50, "keywords": ["摄像头"] }, { "amount": 100, "keywords": ["定身", "陷阱"] }, { "amount": 500, "keywords": ["探查"] }, { "amount": 100, "keywords": ["河蟹", "捕捞"] }], "forbidAmounts": [400] } },
  { "id": "L11", "category": "任务进度", "readAt": { "chapter": 5 }, "from": ["M03"], "text": "读到第 5 章末，任务“找茬魔法少女”已完成", "check": { "kind": "ledger-task", "owner": "苏天晴", "task": ["找茬"], "state": ["已完成", "完成"] } },
  { "id": "L12", "category": "任务进度", "readAt": { "chapter": 8 }, "from": ["M03"], "text": "读到第 8 章末，任务“拥有一个魔法少女代号”已完成", "check": { "kind": "ledger-task", "owner": "苏天晴", "task": ["代号"], "state": ["已完成", "完成"] } },
  { "id": "L13", "category": "任务进度", "readAt": { "chapter": 8 }, "from": ["M03"], "text": "读到第 8 章末，任务“夙愿”已完成", "check": { "kind": "ledger-task", "owner": "苏天晴", "task": ["夙愿"], "state": ["已完成", "完成"] } },
  { "id": "L14", "category": "任务进度", "readAt": { "chapter": 12 }, "from": ["M03"], "text": "读到第 12 章末，任务“反派的自我修养”进行中，进度 0/10", "check": { "kind": "ledger-task", "owner": "苏天晴", "task": ["自我修养"], "state": ["进行中", "0/10"], "progress": "0/10" } },
  { "id": "L15", "category": "任务进度", "readAt": { "chapter": 12 }, "from": ["M03"], "text": "读到第 12 章末，任务“扩充”（发展一名新的正牌魔法少女）进行中，进度 0/1", "check": { "kind": "ledger-task", "owner": "苏天晴", "task": ["扩充", "发展"], "state": ["进行中", "0/1"], "progress": "0/1" } },
  { "id": "T1", "category": "时间", "readAt": { "chapter": 4 }, "from": ["金标"], "text": "第 3 章白天（3.60）和第 4 章夜战（4.100）是同一天", "check": { "kind": "time-relation", "a": { "chapter": 3, "paragraph": 60 }, "b": { "chapter": 4, "paragraph": 100 }, "relation": "same" } },
