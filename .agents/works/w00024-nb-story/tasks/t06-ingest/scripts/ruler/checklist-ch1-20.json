  { "id": "K1", "category": "知情", "readAt": { "chapter": 4 }, "from": ["H02a"], "text": "读到第 4 章末，“风信子就是南小风”：读者知道，南小风知道，苏天晴不知道", "check": { "kind": "secret-table", "secret": ["就是南小风", "是南小风", "真名", "本名"], "about": "南小风", "rows": [{ "who": "读者", "state": ["knows", "can-infer"] }, { "who": "南小风", "state": ["knows"] }, { "who": "苏天晴", "state": ["unaware"] }] } },
  { "id": "K2", "category": "知情", "readAt": { "chapter": 5 }, "from": ["H02b"], "text": "读到第 5 章末，苏天晴从秘典情报页知道了风信子就是南小风", "check": { "kind": "secret-table", "secret": ["就是南小风", "是南小风", "真名", "本名"], "about": "南小风", "rows": [{ "who": "苏天晴", "state": ["knows", "read"] }] } },
  { "id": "K3", "category": "知情", "readAt": { "chapter": 20 }, "from": ["H01", "D01"], "text": "读到第 20 章末，“心月狐（狐娘魔法少女）就是苏天晴”：读者和苏天晴知道，南小风不知道，南嘉鱼不知道", "check": { "kind": "secret-table", "secret": ["心月狐", "狐狐就是", "狐娘魔法少女", "狐人魔法少女", "金毛狐娘", "金色狐", "魔法少女就是苏天晴"], "exclude": ["重生", "将成为"], "about": "苏天晴", "rows": [{ "who": "读者", "state": ["knows", "can-infer"] }, { "who": "苏天晴", "state": ["knows"] }, { "who": "南小风", "state": ["unaware"] }, { "who": "南嘉鱼", "state": ["unaware"] }] } },
  { "id": "K4", "category": "知情", "readAt": { "chapter": 20 }, "from": ["H01"], "text": "读到第 20 章末，“南嘉鱼也是反派魔法少女”：读者和南嘉鱼知道，苏天晴不知道", "check": { "kind": "secret-table", "secret": ["反派魔法少女", "魔法少女", "变身者"], "exclude": ["气息"], "about": "南嘉鱼", "rows": [{ "who": "读者", "state": ["knows", "can-infer"] }, { "who": "南嘉鱼", "state": ["knows"] }, { "who": "苏天晴", "state": ["unaware"] }] } },
  { "id": "K5", "category": "知情", "readAt": { "chapter": 20 }, "from": ["H01"], "text": "读到第 20 章末，“风信子就是南小风”：花铃知道（第 14 章亲眼看到变身），白灵知道，苏天晴知道", "check": { "kind": "secret-table", "secret": ["就是南小风", "是南小风", "真名", "本名"], "about": "南小风", "rows": [{ "who": "花铃", "state": ["knows"] }, { "who": "白灵", "state": ["knows"] }, { "who": "苏天晴", "state": ["knows", "read"] }] } },
  { "id": "K6", "category": "知情", "readAt": { "chapter": 10 }, "from": ["H03"], "text": "读到第 10 章末，南嘉鱼不知道心月狐就是苏天晴", "check": { "kind": "secret-table", "secret": ["心月狐", "狐狐就是", "狐娘魔法少女", "狐人魔法少女", "金毛狐娘", "金色狐", "魔法少女就是苏天晴"], "exclude": ["重生", "将成为"], "about": "苏天晴", "rows": [{ "who": "南嘉鱼", "state": ["unaware"] }] } },
  { "id": "K7", "category": "知情", "readAt": { "chapter": 3 }, "from": ["C04"], "text": "读到第 3 章末，秘典知道苏天晴不是原主只是推断（苏天晴的猜测加 3.26 的任务文字），不应记成明写的知道", "check": { "kind": "secret-table", "secret": ["重生", "原主", "另一个人", "原来的主人"], "about": "苏天晴", "rows": [{ "who": "墨丘利秘典", "state": ["knows", "believes", "suspects", "can-infer"], "knowsBasis": ["inferred"] }] } },
  { "id": "K8", "category": "秘密存在", "readAt": { "chapter": 4 }, "from": ["F02a", "对照"], "text": "读到第 4 章末，存在秘密“绿心公园现身的狐娘魔法少女就是苏天晴”，读者知道，南小风不知道", "check": { "kind": "secret-table", "secret": ["心月狐", "狐狐就是", "狐娘魔法少女", "狐人魔法少女", "金毛狐娘", "金色狐", "魔法少女就是苏天晴", "反派魔法少女就是"], "exclude": ["重生", "将成为"], "about": "苏天晴", "rows": [{ "who": "读者", "state": ["knows", "can-infer"] }, { "who": "南小风", "state": ["unaware"] }] } },
  { "id": "K9", "category": "秘密存在", "readAt": { "chapter": 10 }, "from": ["H01"], "text": "读到第 10 章末，存在秘密“南嘉鱼也是反派魔法少女”，读者知道", "check": { "kind": "secret-table", "secret": ["反派魔法少女", "魔法少女", "变身者"], "exclude": ["气息"], "about": "南嘉鱼", "rows": [{ "who": "读者", "state": ["knows", "can-infer"] }] } },
  { "id": "S1", "category": "来源归属", "readAt": { "chapter": 1 }, "from": ["C01"], "text": "“墨丘利秘典绑定成功”“契约成立”这句话的说话人不明（脑中响起的声音），不应记成秘典的台词", "check": { "kind": "records", "keywords": ["绑定成功", "契约成立"], "expect": "记录应写成脑中响起的声音、说话人不明；如果写成“墨丘利秘典说/秘典的文字”且没有标明是推断，就是错。" } },
  { "id": "S2", "category": "来源归属", "readAt": { "chapter": 1 }, "from": ["A01"], "text": "“前世死于急性心肌梗死”是苏天晴自己的猜测，不是旁白事实", "check": { "kind": "records", "keywords": ["心肌梗死", "心梗"], "expect": "记录的类型应是苏天晴的信念或猜测（来源是她的心理活动），不是旁白确认的事实。" } },
  { "id": "S3", "category": "来源归属", "readAt": { "chapter": 1 }, "from": ["C07", "N01"], "text": "太奶在面摊出现只是苏天晴恍惚间的感知，不应记成旁白确认太奶在场；最好留有“太奶是真是幻”的疑问", "check": { "kind": "records", "keywords": ["太奶"], "expect": "关于太奶的记录只要写的是“她听到太奶说话、恍惚间回头看见太奶”这类她的感知就算对（这确实是旁白写的事），有一条疑问问太奶是真是幻更好。只有把“太奶确实在面摊”写成不带感知限定的客观事实，或断定太奶是幻觉，才算错。" } },
  { "id": "S4", "category": "来源归属", "readAt": { "chapter": 3 }, "from": ["C05"], "text": "“风信子擅长近战压制与肉搏，对魔法尚不熟练”来源是秘典情报页的文字，不是风信子自述", "check": { "kind": "records", "keywords": ["近战", "肉搏"], "expect": "记录的来源应是墨丘利秘典的情报文字（文字渠道，出自秘典），不是风信子自己说的，也不是旁白事实。" } },
  { "id": "S5", "category": "来源归属", "readAt": { "chapter": 7 }, "from": ["C06", "A02"], "text": "第 6 章视频里“夷平教学楼/第三学院”是吹牛，不应记成她有这个能力或打算", "check": { "kind": "records", "keywords": ["夷为平地", "夷平"], "expect": "“夷平”应记成苏天晴在视频里的威胁或宣言（她的台词），第 7 章有记录指出这是吹牛、她只会用尾巴发射魔法飞弹更好；把夷平能力或打算写成事实是错。" } },
  { "id": "S6", "category": "来源归属", "readAt": { "chapter": 15 }, "from": ["C02"], "text": "“风信子击退心月狐”是第 15 章新闻的说法，实际没有交战，苏天晴自行撤退", "check": { "kind": "records", "keywords": ["击退"], "expect": "“击退”应记成新闻报道的说法（文字渠道，出自新闻或协会），不是旁白事实；若同时有记录说明实际是苏天晴自己撤退则更好。把“风信子击退了心月狐”写成事实是错。" } },
  { "id": "S7", "category": "来源归属", "readAt": { "chapter": 16 }, "from": ["B01", "D03"], "text": "“君子有酒是南嘉鱼”是苏天晴的推断，不是明写", "check": { "kind": "records", "keywords": ["君子有酒"], "expect": "记录应把“君子有酒就是南嘉鱼”写成苏天晴的推断或猜测（她的信念，或标为推断），不是旁白确认的事实。" } },
  { "id": "S8", "category": "来源归属", "readAt": { "chapter": 5 }, "from": ["C03"], "text": "“抽陀螺的游戏”是比喻，指第 4 章挠痒痒的捉弄，不是另一种游戏", "check": { "kind": "records", "keywords": ["抽陀螺", "陀螺"], "expect": "对：记录说明“抽陀螺”是苏天晴对前一晚捉弄风信子（挠痒痒）的比喻说法；部分：只转述“她所说的抽陀螺的游戏”而没有解释它指什么；错：明确写成另玩了一种叫抽陀螺的游戏或另一件事。没有相关记录算缺。" } },
  { "id": "S9", "category": "来源归属", "readAt": { "chapter": 1 }, "from": ["J06", "A01"], "text": "签约顺序：先答应签约、契约成立后才问内容；答应的理由是变成萝莉本身就是最大奖励", "check": { "kind": "records", "keywords": ["签约", "契约", "签订"], "expect": "记录应体现她没问内容就答应、契约成立后才问具体内容，理由是变成萝莉就是最大奖励；写成她先看了内容再决定签是错。" } },
  { "id": "S10", "category": "来源归属", "readAt": { "chapter": 20 }, "from": ["B03", "D02"], "text": "叔叔是南嘉鱼爷爷奶奶的亲儿子；他是南小风的父亲是推断；不应记叔叔是南嘉鱼的亲生父亲", "check": { "kind": "records", "keywords": ["叔叔"], "expect": "记录应说明叔叔是南嘉鱼养父母（爷爷奶奶）的亲儿子、南小风是他的女儿；“叔叔就是南小风口中的老爸”若有应标为推断。把叔叔记成南嘉鱼的亲生父亲是错。" } },
  { "id": "S11", "category": "来源归属", "readAt": { "chapter": 16 }, "from": ["J25"], "text": "南小风母亲的去向只有父亲的话“去了很远的地方”，是否去世原文没有交代", "check": { "kind": "records", "keywords": ["妈妈", "母亲"], "entities": ["南小风"], "expect": "记录应把“去了很远很远的地方、永远不会回来”记成父亲的话（南小风转述），母亲是否去世不确定；写成母亲已去世的事实是错。" } },
  { "id": "S12", "category": "来源归属", "readAt": { "chapter": 4 }, "from": ["对照 s4-11"], "text": "“风信子的魔法少女天赋是近战压制”是白灵的说法", "check": { "kind": "records", "keywords": ["天赋", "近战压制"], "expect": "记录里写明这是白灵的说法就算对：来源标为白灵的台词，或者文字里写“按白灵的说法”“白灵说”。写成不带归属的旁白事实才算错。" } },
  { "id": "S13", "category": "来源归属", "readAt": { "chapter": 3 }, "from": ["对照 s3-18"], "text": "第 3 章入夜后“怪人袭击绿心公园”是苏天晴听到吼叫、看到路人逃跑后的判断，旁白没有确认", "check": { "kind": "records", "keywords": ["吼叫", "慌乱", "袭击"], "expect": "记录里写明“苏天晴认定、判断今晚有怪人袭击”就算对（来源标为她的心理，或文字里写“苏天晴认定”），旁白只写了吼叫和路人逃跑；把“怪人袭击了公园”写成不带归属的事实才算错。" } },
  { "id": "E1", "category": "身份与对象", "readAt": { "chapter": 16 }, "from": ["B01"], "text": "“金毛狐狐”“屑狐狐”“心月狐”“魔法少女狐狐official”都指苏天晴（本人的称呼，或与她相连的身份和账号）", "check": { "kind": "records", "keywords": ["金毛狐狐", "屑狐狐", "心月狐", "狐狐official", "狐狐 official"], "expect": "这些称呼应登记为苏天晴的称呼，或作为身份、账号对象并有记录把它们和苏天晴连起来；把其中任何一个安给别人是错。" } },
  { "id": "E2", "category": "身份与对象", "readAt": { "chapter": 12 }, "from": ["F02b"], "text": "花铃是秘典适格者列表上的候选（适格度 97%），第 12 章被选作发展对象，尚未成为魔法少女", "check": { "kind": "records", "keywords": ["适格", "97"], "entities": ["花铃"], "expect": "记录应写花铃是适格者候选、被苏天晴选中准备发展；写成她已经是魔法少女是错。" } },
  { "id": "E3", "category": "身份与对象", "readAt": { "chapter": 20 }, "from": ["N02", "B03"], "text": "南嘉鱼的“妹妹”就是南小风，第 20 章揭晓", "check": { "kind": "records", "keywords": ["妹妹"], "expect": "第 20 章应有记录说明南嘉鱼要补课的“妹妹”就是南小风（叔叔家的女儿）。" } },
